{
    "$schema": "https://www.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "allowJs": true,
        "resolveJsonModule": true,
        "lib": [
            "ESNext"
        ],
        "skipLibCheck": true,
        "types": [
            "bun"
        ]
    }
}