{
  "name": "bun-workspace-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "start": "bun --filter '*' start",
    "db:push": "bun --filter '*' db:push",
    "db:gen": "bun --filter '*' db:gen",
    "db:std": "bun --filter '*' db:std",
    "del": "bun --filter '*' del && rm -rf node_modules dist"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "pkg/*"
  ],
  "dependencies": {
    "hono": "^4.13.7",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "zod": "^4.5.4"
  }
}